# FindBack PH - Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# Database
# ===========================================
DATABASE_URL="postgresql://user:password@localhost:5432/findbackph"

# ===========================================
# NextAuth Configuration
# ===========================================
AUTH_SECRET="your-secret-key-min-32-chars-generate-with-node-e"

# ===========================================
# App URL
# ===========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===========================================
# Email Configuration (Choose ONE option)
# ===========================================

# Option 1: Resend (Recommended for Production)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_api_key_here"
RESEND_FROM_EMAIL="FindBack PH <noreply@findbackph.com>"

# Option 2: Gmail SMTP (Alternative)
# Generate App Password at: https://myaccount.google.com/apppasswords
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-16-char-app-password"
# SMTP_FROM_EMAIL="FindBack PH <your-email@gmail.com>"

# Option 3: Development Mode (No email needed, shows link on page)
# DEV_EMAIL_MODE=true

# ===========================================
# Node Environment
# ===========================================
NODE_ENV="development"
