{
  "name": "findback-ph",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/prebuild.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:setup:local": "tsx scripts/setup-db-provider.ts && npx prisma migrate deploy && npx prisma db seed && npx tsx scripts/ensure-admin-consistency.ts",
    "db:setup:production": "DATABASE_URL=$DATABASE_URL tsx scripts/setup-db-provider.ts && npx prisma migrate deploy && npx prisma db seed && npx tsx scripts/ensure-admin-consistency.ts",
    "admin:consistency": "npx tsx scripts/ensure-admin-consistency.ts",
    "admin:list-users": "npx tsx scripts/list-all-users.ts",
    "watch:commit": "node scripts/auto-commit.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/nodemailer": "^8.0.1",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jose": "^5.10.0",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.23.3",
    "next": "^15.4.4",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^6.18.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "chokidar": "^5.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "sharp@0.34.5": true,
    "@prisma/client@6.19.3": true
  }
}
