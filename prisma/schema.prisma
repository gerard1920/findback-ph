generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String              @id @default(uuid())
  email                   String              @unique
  passwordHash            String
  displayName             String
  username                String              @unique
  avatarUrl               String?
  phoneNumber             String?
  campus                  String?
  preferredProvince       String?
  preferredCity           String?
  allowMessages           Boolean             @default(true)
  allowMessageRequests    Boolean             @default(true)
  notifyOnCommentEmail    Boolean             @default(true)
  notifyOnCommentInApp    Boolean             @default(true)
  notifyOnClaimEmail      Boolean             @default(true)
  notifyOnClaimInApp      Boolean             @default(true)
  notifyOnMessageEmail    Boolean             @default(true)
  notifyOnMessageInApp    Boolean             @default(true)
  notifyPossibleMatchInApp Boolean            @default(true)
  notifyPossibleMatchEmail Boolean            @default(true)
  notifySimilarFoundInApp  Boolean             @default(true)
  notifySimilarFoundEmail  Boolean             @default(true)
  notifyReportUpdatesInApp Boolean            @default(true)
  notifyReportUpdatesEmail Boolean            @default(true)
  notifyItemStatusInApp    Boolean             @default(true)
  notifyItemStatusEmail    Boolean             @default(true)
  notifyMessageRequestInApp Boolean           @default(true)
  notifyMessageRequestEmail Boolean           @default(true)
  notifySuspiciousInApp    Boolean             @default(true)
  notifySuspiciousEmail    Boolean             @default(true)
  notifySecurityInApp      Boolean             @default(true)
  notifySecurityEmail      Boolean             @default(true)
  notifyAccountInApp       Boolean             @default(true)
  notifyAccountEmail       Boolean             @default(true)
  notifyImportantEmail     Boolean             @default(true)
  notifyWeeklySummary      Boolean             @default(true)
  role                    String                @default("USER")
  status                  String                @default("ACTIVE")
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  items                   Item[]
  savedItems              SavedItem[]
  notifications           Notification[]
  messages                Message[]
  messageReactions        MessageReaction[]
  reportsMade             Report[]            @relation("ReportReporter")
  reportsAboutMe          Report[]            @relation("ReportedUser")
  blockedUsers            Block[]             @relation("Blocker")
  blockedBy               Block[]             @relation("Blocked")
  passwordResets          PasswordReset[]
  bans                    Ban[]               @relation("BannedUser")
  bansIssued              Ban[]               @relation("BanAdmin")
  adminLogs               AdminLog[]          @relation("AdminLogAdmin")
  claims                  Claim[]             @relation("Claimant")
  claimReviews            Claim[]             @relation("ClaimReviewer")
  @@index([createdAt])
}
model Category {
  id    String @id @default(uuid())
  name  String @unique
  slug  String @unique
  items Item[]
}
model Item {
  id                     String      @id @default(uuid())
  ownerId                String
  owner                  User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  categoryId             String
  category               Category    @relation(fields: [categoryId], references: [id])
  type                   String
  status                 String  @default("ACTIVE")
  flagged                Boolean     @default(false)
  title                  String
  brand                  String?
  color                  String?
  serialNumber           String?
  description            String
  distinguishingFeatures String?
  privateSerial          String?
  privateProof           String?
  reward                 String?
  province               String
  city                   String
  barangay               String?
  approximateLocation    String
  latitude               Float?
  longitude              Float?
  dateOccurred           DateTime
  images                 ItemImage[]
  savedBy                SavedItem[]
  claims                 Claim[]
  reports                Report[]
  matchesLost            Match[]     @relation("MatchLostItem")
  matchesFound           Match[]     @relation("MatchFoundItem")
  conversations          Conversation[]
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  @@index([type, status, createdAt])
  @@index([categoryId])
  @@index([province, city])
}
model ItemImage {
  id        String   @id @default(uuid())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  createdAt DateTime @default(now())
}
model Match {
  id          String      @id @default(uuid())
  lostItemId  String
  foundItemId String
  lostItem    Item        @relation("MatchLostItem", fields: [lostItemId], references: [id])
  foundItem   Item        @relation("MatchFoundItem", fields: [foundItemId], references: [id])
  score       Int
  status      String     @default("PENDING")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  @@unique([lostItemId, foundItemId])
  @@index([lostItemId])
  @@index([foundItemId])
}
model Claim {
  id                 String      @id @default(uuid())
  itemId             String
  item               Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  claimantId         String
  claimant           User        @relation("Claimant", fields: [claimantId], references: [id])
  reviewerId         String?
  reviewer           User?       @relation("ClaimReviewer", fields: [reviewerId], references: [id])
  verificationAnswer String
  status             String     @default("PENDING")
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  @@index([itemId, status])
}
model Conversation {
  id             String    @id @default(uuid())
  itemId         String?
  item           Item?     @relation(fields: [itemId], references: [id], onDelete: SetNull)
  participantAId String
  participantBId String
  pinnedByA      Boolean   @default(false)
  pinnedByB      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  messages       Message[]
  @@unique([itemId, participantAId, participantBId])
}
model Message {
  id              String       @id @default(uuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User         @relation(fields: [senderId], references: [id])
  type            String       @default("TEXT")
  body            String
  attachmentUrl   String?
  attachmentName  String?
  attachmentSize  Int?
  attachmentMime  String?
  durationSeconds Int?
  replyToId       String?
  replyTo         Message?     @relation("MessageReply", fields: [replyToId], references: [id])
  status          String       @default("SENT")
  deliveredAt     DateTime?
  readAt          DateTime?
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  reactions       MessageReaction[]
  replies         Message[]    @relation("MessageReply")
  @@index([conversationId, createdAt])
}
model MessageReaction {
  id         String   @id @default(uuid())
  messageId  String
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji      String
  createdAt  DateTime @default(now())
  @@unique([messageId, userId, emoji])
  @@index([messageId])
}
model Notification {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String    @default("general")
  title           String
  body            String
  icon            String?
  referenceId     String?
  referenceType   String?
  link            String?
  readAt          DateTime?
  createdAt       DateTime  @default(now())
  @@index([userId, readAt])
}
model SavedItem {
  userId    String
  itemId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([userId, itemId])
}
model Report {
  id             String       @id @default(uuid())
  itemId         String?
  item           Item?        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  reporterId     String
  reporter       User         @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId String?
  reportedUser   User?        @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reason         String
  details        String?
  status         String       @default("PENDING")
  resolvedAt     DateTime?
  resolvedBy     String?
  createdAt      DateTime     @default(now())
  @@index([status, createdAt])
}
model Block {
  blockerId String
  blockedId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([blockerId, blockedId])
}
model PasswordReset {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  @@index([expiresAt])
}
model Ban {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)
  adminId   String?
  admin     User?     @relation("BanAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  action    String // "BAN" | "SUSPEND" | "UNBAN"
  reason    String
  expiresAt DateTime?
  liftedAt  DateTime?
  createdAt DateTime  @default(now())
  @@index([userId])
  @@index([createdAt])
}
model AdminLog {
  id         String   @id @default(uuid())
  adminId    String?
  admin      User?    @relation("AdminLogAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  reason     String?
  createdAt  DateTime @default(now())
  @@index([createdAt])
  @@index([adminId])
}

