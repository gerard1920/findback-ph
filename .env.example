# Database
# Local development (if using PostgreSQL locally):
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/findback"
# Production (Neon/PlanetScale/etc):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# MySQL alternative:
# DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"
DATABASE_URL=

# JWT signing secret for sessions. Use a long random string in production.
AUTH_SECRET=

# Public site URL. Used for password-reset links and absolute URLs.
NEXT_PUBLIC_APP_URL=

# Email provider: Resend API key (recommended) or leave empty to disable email sends.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional Gmail SMTP fallback
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_EMAIL=

# Optional: password-reset behavior
# DEV_EMAIL_MODE=false

# Optional: matching sensitivity
# MATCH_THRESHOLD=60
