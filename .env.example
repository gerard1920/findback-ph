# FindBack PH - Environment Variables Example
# Copy this file to .env and fill in your values

# ===========================================
# DATABASE CONFIGURATION (MySQL - InfinityFree)
# ===========================================
DB_HOST=sqlXXX.infinityfree.com
DB_NAME=if0_XXXXXXXX_findbackph
DB_USER=if0_XXXXXXXX
DB_PASS=your_database_password

# ===========================================
# APPLICATION SETTINGS
# ===========================================
APP_URL=https://findbackph.infinityfree.me
APP_NAME=FindBack PH

# ===========================================
# SECURITY
# ===========================================
JWT_SECRET=CHANGE-THIS-TO-A-RANDOM-SECRET-KEY-AT-LEAST-32-CHARS

# ===========================================
# EMAIL CONFIGURATION (Gmail SMTP)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=FindBack PH <your-email@gmail.com>

# ===========================================
# FILE UPLOAD SETTINGS
# ===========================================
MAX_FILE_SIZE=5242880
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# ===========================================
# SESSION SETTINGS
# ===========================================
SESSION_LIFETIME=604800
