DATABASE_URL="postgresql://postgres:postgres@localhost:5432/findback_ph"
AUTH_SECRET="generate-a-long-random-secret-at-least-32-characters"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MAPBOX_TOKEN=

# ================ EMAIL CONFIGURATION ================
# Choose ONE of the following options for password reset emails:

# OPTION 1: Development Mode (EASIEST - works for ANY email, shows link on page)
# Set this to true to skip actual email sending and display reset links directly on the page.
# Perfect for local testing - works with any Gmail address or any email!
DEV_EMAIL_MODE=true

# OPTION 2: Gmail / SMTP (Send to ANY email address - Gmail, Yahoo, Outlook, etc.)
# To use Gmail:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification on your Google account
#   3. Go to https://myaccount.google.com/apppasswords
#   4. Generate an App Password (16 characters)
#   5. Fill in the values below:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop   (your 16-character App Password with spaces)
# SMTP_FROM_EMAIL="FindBack PH <yourname@gmail.com>"

# OPTION 3: Resend (Original - limited without verified domain)
RESEND_API_KEY=
RESEND_FROM_EMAIL="FindBack PH <onboarding@resend.dev>"
